generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                String                 @id @default(uuid())
  email             String                 @unique
  passwordHash      String
  fullName          String
  phone             String?
  customerCode      String?                @unique
  balance           Int                    @default(0)
  status            String                 @default("ACTIVE")
  address           String?
  avatarUrl         String?
  roleCode          String                 @default("CUSTOMER")
  roleId            String?
  role              Role?                  @relation(fields: [roleId], references: [id])
  preferredLanguage String                 @default("vi")
  warehouseId       String?
  warehouse         Warehouse?             @relation(fields: [warehouseId], references: [id])
  parcels           Parcel[]               @relation("CustomerParcels")
  scannedParcels    ParcelScanLog[]
  transactions      FinancialTransaction[]
  auditLogs         AuditLog[]
  disputes          Dispute[]
  withdrawals       WithdrawalRequest[]
  depositRequests   DepositRequest[]
  attendanceRecords AttendanceRecord[]
  employeeLeaveRequests EmployeeLeaveRequest[]
  notifications     Notification[]
  affiliateProfile  AffiliateProfile?
  commissions       AffiliateCommission[] @relation("CommissionOwner")
  exchangeTransactions ExchangeTransaction[]
  orders            Order[]
  payments          Payment[]
  deliveryRequests  DeliveryRequest[]
  transportRequests TransportRequest[]
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model TransportRequest {
  id                      String   @id @default(uuid())
  requestCode             String   @unique
  customerId              String
  customer                User     @relation(fields: [customerId], references: [id])
  categoryId              String
  categoryName            String
  goodsDescription        String
  quantity                Int      @default(1)
  weightKg                Float
  lengthCm                Float
  widthCm                 Float
  heightCm                Float
  chargeableWeight        Float
  shippingMethod          String   @default("STANDARD")
  destinationWarehouse    String?
  recipientName           String
  recipientPhone          String
  recipientEmail          String?
  country                 String   @default("VN")
  customCountry           String?
  province                String
  district                String
  ward                    String
  addressLine             String
  deliveryNote            String?
  pickupContactName       String
  pickupPhone             String
  pickupCountry           String   @default("CN")
  pickupCustomCountry     String?
  pickupProvince          String
  pickupDistrict          String
  pickupWard              String
  pickupAddressLine       String
  pickupNote              String?
  pickupImage             String?
  declaredValueVnd        Int      @default(0)
  insurance               Boolean  @default(false)
  estimatedShippingFeeVnd Int
  insuranceFeeVnd         Int      @default(0)
  estimatedTotalVnd       Int
  trackingCodeChina       String?
  status                  String   @default("PENDING")
  adminNote               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model ExchangeTransaction {
  id              String   @id @default(uuid())
  transactionCode String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  direction       String
  sourceAmount    Decimal
  targetAmount    Decimal
  exchangeRate    Decimal
  recipientInfo   String
  proofImage      String?
  fundingMethod   String   @default("WALLET")
  status          String   @default("PENDING")
  rejectionReason String?
  reviewNote      String?
  reviewImage     String?
  reviewedBy      String?
  reviewedAt      DateTime?
  heldAmountVnd   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Order {
  id              String      @id @default(uuid())
  orderCode       String      @unique
  customerId      String
  customer        User        @relation(fields: [customerId], references: [id])
  platform        String
  status          String      @default("PENDING")
  currency        String      @default("CNY")
  exchangeRate    Decimal
  subtotalVnd     Int
  serviceFeeVnd   Int         @default(0)
  totalVnd        Int
  depositRequiredVnd Int
  depositPaidVnd  Int         @default(0)
  paidVnd         Int         @default(0)
  remainingVnd    Int         @default(0)
  notes           String?
  items           OrderItem[]
  payments        Payment[]
  parcels         Parcel[]
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Payment {
  id             String   @id @default(uuid())
  paymentCode    String   @unique
  idempotencyKey String   @unique
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id])
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  purpose        String
  method         String   @default("WALLET")
  provider       String?
  providerRef    String?  @unique
  amountVnd      Int
  status         String   @default("PENDING")
  rawPayload     String?
  completedAt    DateTime?
  refundedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model OrderItem {
  id          String @id @default(uuid())
  orderId     String
  order       Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  productUrl  String?
  imageUrl    String?
  attributes  String?
  quantity    Int
  unitPriceCny Decimal
  totalCny    Decimal
}

model DeliveryRequest {
  id             String   @id @default(uuid())
  requestCode    String   @unique
  customerId     String
  customer       User     @relation(fields: [customerId], references: [id])
  parcels        Parcel[]
  address        String
  contactPhone   String
  shippingMethod String   @default("STANDARD")
  feeVnd         Int      @default(0)
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model Dispute {
  id          String   @id @default(uuid())
  disputeCode String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  parcelId    String?
  category    String
  title       String
  description String
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WithdrawalRequest {
  id            String   @id @default(uuid())
  requestCode   String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  amountVnd     Int
  source        String   @default("WALLET")
  bankName      String
  accountNumber String
  accountName   String
  status        String   @default("PENDING")
  reviewNote    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model DepositRequest {
  id          String   @id @default(uuid())
  requestCode String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountVnd   Int
  method      String
  proofImage  String?
  status      String   @default("PENDING")
  reviewNote  String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  workDate  String
  checkIn   DateTime
  checkOut  DateTime?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, workDate])
}

model EmployeeLeaveRequest {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  leaveDate  String
  leaveType  String   @default("PAID")
  reason     String
  status     String   @default("PENDING")
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, leaveDate])
}

model AffiliateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  affiliateCode   String   @unique
  commissionRate  Float    @default(0.02)
  status          String   @default("PENDING")
  totalCommission Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  referrals       AffiliateReferral[]
  clicks          AffiliateClick[]
}

model AffiliateClick {
  id                 String           @id @default(uuid())
  eventId            String           @unique
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id])
  ipAddress          String?
  userAgent          String?
  createdAt          DateTime         @default(now())
}

model AffiliateReferral {
  id                 String           @id @default(uuid())
  affiliateProfileId String
  affiliateProfile   AffiliateProfile @relation(fields: [affiliateProfileId], references: [id])
  customerId         String           @unique
  registeredAt       DateTime         @default(now())
}

model AffiliateCommission {
  id          String   @id @default(uuid())
  ownerId     String
  owner       User     @relation("CommissionOwner", fields: [ownerId], references: [id])
  customerId  String
  orderRef    String?
  amountVnd   Int
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  approvedAt  DateTime?
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  targetRole String  @default("ALL")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SystemSetting {
  key       String   @id
  value     String
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Warehouse {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  type        String          // 'CHINA' | 'VIETNAM'
  country     String
  province    String?
  city        String?
  district    String?
  address     String
  contactName String?
  phone       String?
  users       User[]
  parcels     Parcel[]        @relation("WarehouseLocation")
  scans       ParcelScanLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Parcel {
  id                 String          @id @default(uuid())
  trackingCodeChina  String          @unique
  parcelCode         String          @unique
  customerId         String
  customer           User            @relation("CustomerParcels", fields: [customerId], references: [id])
  currentWarehouseId String?
  currentWarehouse   Warehouse?      @relation("WarehouseLocation", fields: [currentWarehouseId], references: [id])
  shipmentId         String?
  shipment           Shipment?       @relation(fields: [shipmentId], references: [id])
  orderId             String?
  order               Order?          @relation(fields: [orderId], references: [id])
  weightKg           Float           @default(0)
  lengthCm           Float           @default(0)
  widthCm            Float           @default(0)
  heightCm           Float           @default(0)
  chargeableWeight   Float           @default(0)
  status             String          @default("CREATED") // 'CREATED' | 'RECEIVED_CHINA' | 'IN_TRANSIT' | 'RECEIVED_VIETNAM' | 'DELIVERED' | 'CANCELLED'
  notes              String?
  scanLogs           ParcelScanLog[]
  deliveryRequests   DeliveryRequest[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model ParcelScanLog {
  id          String    @id @default(uuid())
  parcelId    String
  parcel      Parcel    @relation(fields: [parcelId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  staffId     String
  staff       User      @relation(fields: [staffId], references: [id])
  statusAfter String
  notes       String?
  createdAt   DateTime  @default(now())
}

model Shipment {
  id                  String    @id @default(uuid())
  shipmentCode        String    @unique
  originWarehouseCode String
  destWarehouseCode   String
  status              String    @default("DRAFT") // 'DRAFT' | 'DISPATCHED' | 'IN_CUSTOMS' | 'ARRIVED_DESTINATION' | 'COMPLETED'
  parcels             Parcel[]
  dispatchedAt        DateTime?
  arrivedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model ShippingRate {
  id             String   @id @default(uuid())
  shippingMethod String   // 'ROAD' | 'AIR'
  minWeight      Float
  maxWeight      Float
  pricePerKg     Int
  estimatedDays  String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FinancialTransaction {
  id            String   @id @default(uuid())
  transactionNo String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String   // 'DEPOSIT' | 'SHIPPING_FEE' | 'SERVICE_FEE' | 'REFUND' | 'WITHDRAWAL'
  amountVnd     Int
  balanceAfter  Int
  description   String
  createdAt     DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// CMS CONTENT MODELS (Services, Guides, Policies, Announcements, Blogs)
// ----------------------------------------------------

model Service {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   // '1688' | 'TMALL' | 'NHAP_HANG' | 'VAN_CHUYEN' | 'XNK' | 'ALIPAY'
  summary     String
  content     String
  iconName    String   @default("Package")
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guide {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   // 'DAT_HANG' | 'NAP_TIEN' | 'APP' | 'RUT_TIEN'
  summary     String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Policy {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  category    String   // 'MUA_HANG' | 'KHIEU_NAI' | 'DONG_GO' | 'KIEM_HANG'
  summary     String
  content     String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  priority    String   @default("NORMAL") // 'NORMAL' | 'HIGH' | 'URGENT'
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  summary     String
  content     String
  category    String   @default("Kinh Nghiệm")
  author      String   @default("OrderChinaViet Team")
  coverImage  String?
  readTime    String   @default("5 phút đọc")
  tags        String   @default("[]")
  featured    Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JobApplication {
  id              String    @id @default(uuid())
  applicationCode String    @unique
  fullName        String
  phone           String
  email           String?
  position        String    @default("Cộng tác viên kinh doanh Online (Remote)")
  city            String?
  experience      String?
  note            String?
  cvUrl           String?
  status          String    @default("PENDING") // 'PENDING' | 'REVIEWING' | 'INTERVIEWED' | 'ACCEPTED' | 'REJECTED'
  adminNotes      String?
  interviewDate   DateTime?
  salaryOffer     String?   @default("2.000.000 ₫ + Hoa hồng")
  activationToken String?   @unique
  tokenExpiresAt  DateTime?
  isActivated     Boolean   @default(false)
  activatedUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
